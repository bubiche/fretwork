  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.2",
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^24.12.3",
    "typescript": "~6.0.2",
    "vite": "^7.3.3",
    "vitest": "4.1.7"
  }
}
